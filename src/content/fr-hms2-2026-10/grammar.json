[
  { "id": "ca01", "unit": "g-comp-adj", "type": "gap", "prompt": "Paul est ___ que Marc.", "hint": "(grand, +)", "answers": ["plus grand"], "options": ["plus grand", "aussi grand", "plus grande", "le plus grand"] },
